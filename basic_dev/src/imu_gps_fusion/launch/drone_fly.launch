<launch>
  <arg name="enable_sim_time" default="true"/>
  <arg name="use_rviz" default="false"/>
  <arg name="start_pwm_adrc" default="true"/>
  <arg name="start_pwm_se3" default="false"/>
  <arg name="start_imu_gps_fusion" default="true"/>
  <arg name="start_ab_planner" default="true"/>
  <arg name="start_lidar_solver" default="true"/>
  <arg name="start_qianli" default="false"/>

  <param name="/use_sim_time" value="$(arg enable_sim_time)"/>

  <include if="$(arg start_imu_gps_fusion)" file="$(find imu_gps_fusion)/launch/imu_gps_fusion.launch">
    <arg name="enable_sim_time" value="$(arg enable_sim_time)"/>
    <arg name="use_rviz" value="$(arg use_rviz)"/>
  </include>

  <node if="$(arg start_pwm_adrc)" pkg="pwm_adrc_controller" type="pwm_adrc_controller" name="pwm_adrc_controller" output="screen">
    <param name="use_planner_input" value="true"/>
    <param name="planner_cmd_topic" value="/pose_cmd"/>
    <param name="planner_z_offset" value="0.5"/>
    <param name="max_planner_target_age_sec" value="0.5"/>
  </node>
  <node if="$(arg start_pwm_se3)" pkg="pwm_se3_controller" type="pwm_se3_controller" name="pwm_se3_controller" output="screen"/>

  <include if="$(arg start_ab_planner)" file="$(find AB_planner)/launch/AB_planner.launch">
    <arg name="enable_sim_time" value="$(arg enable_sim_time)"/>
    <arg name="use_rviz" value="$(arg use_rviz)"/>
  </include>

  <include if="$(arg start_lidar_solver)" file="$(find lidar_solver)/launch/lidar_solver.launch">
    <arg name="enable_sim_time" value="$(arg enable_sim_time)"/>
    <arg name="use_rviz" value="$(arg use_rviz)"/>
  </include>

  <include if="$(arg start_qianli)" file="$(find ego_planner)/launch/qianli_planner.launch"/>
</launch>
