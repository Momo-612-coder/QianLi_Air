<launch>
    <arg name="use_rviz" default="false"/>
    <arg name="enable_sim_time" default="false"/>

    <param name="/use_sim_time" value="$(arg enable_sim_time)"/>

    <param name="robot_description" command="$(find xacro)/xacro $(find imu_gps_fusion)/urdf/drone.urdf.xacro"/>
    <node pkg="tf2_ros" type="static_transform_publisher" name="link_map_to_camera_init" args="0 0 0 0 0 0 map_rviz camera_init" />
    <node pkg="tf2_ros" type="static_transform_publisher" name="link_lidar_link_to_lidar" args="0 0 0 0 0 0 lidar_link lidar" />
    <node pkg="imu_gps_fusion" type="imu_clock_publisher" name="imu_clock_publisher" output="screen" required="true"/>
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen"/>
    <node pkg="imu_gps_fusion" type="imu_gps_fusion" name="imu_gps_fusion" output="screen"/>
    <node if="$(arg use_rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find imu_gps_fusion)/launch/fusion_view.rviz" />
</launch>
