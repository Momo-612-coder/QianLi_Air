drone01Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /drone01
        - /TruePath1
        - /FusedPath1
      Splitter Ratio: 0.5
    Tree Height: 549
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 0; 255; 0
      Enabled: true
      Head Diameter: 0.10000000149011612
      Head Length: 0.20000000298023224
      Length: 0.30000001192092896
      Line Style: Lines
      Line Width: 0.029999999329447746
      Name: TruePath
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.029999999329447746
      Shaft Diameter: 0.05000000074505806
      Shaft Length: 0.10000000149011612
      Topic: /true_path
      Unreliable: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 0; 0
      Enabled: true
      Head Diameter: 0.10000000149011612
      Head Length: 0.20000000298023224
      Length: 0.30000001192092896
      Line Style: Lines
      Line Width: 0.029999999329447746
      Name: FusedPath
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.029999999329447746
      Shaft Diameter: 0.05000000074505806
      Shaft Length: 0.10000000149011612
      Topic: /fused_path
      Unreliable: false
      Value: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        map:
          base_link:
            back_left_camera_link:
              {}
            back_right_camera_link:
              {}
            front_left_camera_link:
              {}
            front_right_camera_link:
              {}
            lidar_link:
              {}
          map_rviz:
            {}
      Update Interval: 0
      Value: true
    - Class: rviz/PointCloud2
      Enabled: true
      Name: Filtered PointCloud
      Topic: /visualized_point_cloud
      Size (Pixels): 2
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 255; 255
    - Class: rviz/Group
      Enabled: true
      Name: Point-LIO Mapping
      Displays:
        - Class: rviz/PointCloud2
          Enabled: true
          Name: PointLIO Surround
          Topic: /cloud_registered
          Color Transformer: AxisColor
          Channel Name: intensity
          Size (Pixels): 3
          Style: Points
          Use Fixed Frame: true
          Queue Size: 1
        - Class: rviz/PointCloud2
          Enabled: true
          Name: PointLIO Current Points
          Topic: /cloud_registered
          Color Transformer: AxisColor
          Channel Name: intensity
          Size (Pixels): 1
          Style: Points
          Decay Time: 0
          Use Fixed Frame: true
          Queue Size: 2
        - Class: rviz/PointCloud2
          Enabled: false
          Name: PointLIO Effected
          Topic: /cloud_effected
          Color Transformer: Intensity
          Channel Name: intensity
          Size (Pixels): 4
          Style: Spheres
          Queue Size: 10
        - Class: rviz/PointCloud2
          Enabled: false
          Name: PointLIO Laser Map
          Topic: /Laser_map
          Color Transformer: FlatColor
          Color: 138; 226; 52
          Size (Pixels): 3
          Style: Flat Squares
          Queue Size: 10
    - Class: rviz/Odometry
      Enabled: true
      Name: PointLIO Odometry
      Topic: /aft_mapped_to_init
      Queue Size: 10
      Keep: 1
    - Class: rviz/Path
      Enabled: true
      Name: PointLIO Path
      Topic: /path
      Buffer Length: 2
      Line Style: Billboards
      Line Width: 0.20000000298023224
      Color: 25; 255; 255
      Pose Style: None
    - Class: rviz/MarkerArray
      Enabled: true
      Name: Detected Objects MarkerArray
      Topic: /detected_bounding_boxes
      Marker Topic: /detected_bounding_boxes
      Namespaces:
        cluster_bboxes: true
    - Class: rviz/MarkerArray
      Enabled: true
      Name: Score Gate Target Marker
      Topic: /image_solver/score_gate_target_marker
      Marker Topic: /image_solver/score_gate_target_marker
      Namespaces:
        score_gate_target: true
        score_gate_target_text: true
    - Class: rviz/Group
      Displays:
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /drone_0_ego_planner_node/goal_point
          Name: goal_point
          Namespaces:
            {}
          Queue Size: 100
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /drone_0_ego_planner_node/optimal_list
          Name: optimal_traj
          Namespaces:
            "": true
          Queue Size: 100
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /drone_0_ego_planner_node/global_list
          Name: global_traj
          Namespaces:
            "": true
          Queue Size: 100
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 29; 108; 212
          Enabled: true
          Head Diameter: 0.3
          Head Length: 0.2
          Length: 0.3
          Line Style: Billboards
          Line Width: 0.1
          Name: drone_path
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 85; 255
          Pose Style: None
          Queue Size: 10
          Radius: 0.03
          Shaft Diameter: 0.1
          Shaft Length: 0.1
          Topic: /drone_0_odom_visualization/path
          Unreliable: false
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 255; 170; 0
          Enabled: true
          Head Diameter: 0.3
          Head Length: 0.2
          Length: 0.3
          Line Style: Billboards
          Line Width: 0.12
          Name: AB Planner Path
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 85; 255
          Pose Style: None
          Queue Size: 10
          Radius: 0.03
          Shaft Diameter: 0.1
          Shaft Length: 0.1
          Topic: /AB_planner/planned_path
          Unreliable: false
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 0; 220; 255
          Enabled: true
          Head Diameter: 0.3
          Head Length: 0.2
          Length: 0.3
          Line Style: Billboards
          Line Width: 0.08
          Name: AB B-spline Path
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 85; 255
          Pose Style: None
          Queue Size: 10
          Radius: 0.03
          Shaft Diameter: 0.1
          Shaft Length: 0.1
          Topic: /AB_planner/bspline_path
          Unreliable: false
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 255; 0; 255
          Enabled: true
          Head Diameter: 0.3
          Head Length: 0.2
          Length: 0.3
          Line Style: Billboards
          Line Width: 0.1
          Name: AB MPC Prediction
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 85; 255
          Pose Style: None
          Queue Size: 10
          Radius: 0.03
          Shaft Diameter: 0.1
          Shaft Length: 0.1
          Topic: /AB_planner/mpc_prediction_path
          Unreliable: false
          Value: true
        - Class: rviz/Group
          Displays:
            - Alpha: 1
              Autocompute Intensity Bounds: true
              Autocompute Value Bounds:
                Max Value: 10
                Min Value: -10
                Value: true
              Axis: Z
              Channel Name: intensity
              Class: rviz/PointCloud2
              Color: 120; 120; 120
              Color Transformer: FlatColor
              Decay Time: 0.2
              Enabled: false
              Invert Rainbow: false
              Max Color: 255; 255; 255
              Max Intensity: 4096
              Min Color: 0; 0; 0
              Min Intensity: 0
              Name: Raw AirSim LiDAR
              Position Transformer: XYZ
              Queue Size: 2
              Selectable: true
              Size (Pixels): 2
              Size (m): 0.08
              Style: Points
              Topic: /airsim_node/drone_1/lidar
              Unreliable: false
              Use Fixed Frame: true
              Use rainbow: true
              Value: false
            - Alpha: 1
              Autocompute Intensity Bounds: true
              Autocompute Value Bounds:
                Max Value: 10
                Min Value: -10
                Value: true
              Axis: Z
              Channel Name: intensity
              Class: rviz/PointCloud2
              Color: 0; 255; 255
              Color Transformer: FlatColor
              Decay Time: 0.35
              Enabled: true
              Invert Rainbow: false
              Max Color: 255; 255; 255
              Max Intensity: 4096
              Min Color: 0; 0; 0
              Min Intensity: 0
              Name: AB Filtered Avoidance Points
              Position Transformer: XYZ
              Queue Size: 2
              Selectable: true
              Size (Pixels): 4
              Size (m): 0.12
              Style: Spheres
              Topic: /AB_planner/pointcloud_obstacles
              Unreliable: false
              Use Fixed Frame: true
              Use rainbow: true
              Value: true
            - Class: rviz/MarkerArray
              Enabled: true
              Marker Topic: /AB_planner/pointcloud_inflated_markers
              Name: AB Inflated Avoidance Volume
              Namespaces:
                ab_planner_pointcloud_inflation: true
              Queue Size: 2
              Topic: /AB_planner/pointcloud_inflated_markers
              Value: true
          Enabled: true
          Name: AB PointCloud Avoidance
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 3.0
            Min Value: 0.0
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 29; 108; 212
          Color Transformer: AxisColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Max Intensity: 4096
          Min Color: 0; 0; 0
          Min Intensity: 0
          Name: map_inflate
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.1
          Style: Flat Squares
          Topic: /drone_0_ego_planner_node/grid_map/occupancy_inflate
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /drone_0_odom_visualization/robot
          Name: robot
          Namespaces:
            mesh: true
          Queue Size: 100
          Value: true
      Enabled: true
      Name: drone0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map_rviz
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Theta std deviation: 0.2617993950843811
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 10
      Enable Suspend: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.785398006439209
      Target Frame: <Fixed Frame>
      Yaw: 0.785398006439209
    Saved: ~
